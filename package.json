{
  "name": "@dreamer/ui-preact",
  "version": "1.1.0",
  "description": "Preact UI components for Dreamer. Migrated from ui-view (desktop + mobile path parity, shared implementations).",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./basic": "./src/desktop/basic/mod.ts",
    "./form": "./src/desktop/form/mod.ts",
    "./layout": "./src/shared/layout/mod.ts",
    "./feedback": "./src/shared/feedback/mod.ts",
    "./navigation": "./src/shared/navigation/mod.ts",
    "./data-display": "./src/shared/data-display/mod.ts",
    "./config-provider": "./src/shared/config-provider/mod.ts",
    "./charts": "./src/shared/charts/mod.ts",
    "./shared": "./src/shared/mod.ts",
    "./mobile": "./src/mobile/mod.ts",
    "./mobile/basic": "./src/mobile/basic/mod.ts",
    "./mobile/form": "./src/mobile/form/mod.ts"
  },
  "scripts": {
    "test": "deno test -A tests/collect-desktop-routes.test.ts tests/docs-sidebar-reconcile.test.ts",
    "test:node": "node --import tsx --test-force-exit test-node.mjs",
    "check": "deno check src plugin.ts"
  },
  "dependencies": {
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@^1.1.2",
    "@dreamer/esbuild": "npm:@jsr/dreamer__esbuild@^1.3.0",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.1.0",
    "@dreamer/plugin": "npm:@jsr/dreamer__plugin@^1.1.0",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.2",
    "@dreamer/service": "npm:@jsr/dreamer__service@^1.1.0",
    "@dreamer/markdown": "npm:@jsr/dreamer__markdown@^1.1.1",
    "tailwind-merge": "npm:tailwind-merge@^2.6.1",
    "preact": "npm:preact@^10.29.2",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "chart.js": "npm:chart.js@4.5.1",
    "prismjs": "npm:prismjs@1.30.0"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "playwright": "npm:playwright@1.59.1",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "keywords": [
    "ui",
    "preact",
    "dreamer",
    "components"
  ]
}
